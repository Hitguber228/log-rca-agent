# ==============================================================================
# SRE Log RCA Agent & Observability Platform — Environment Configuration
# ==============================================================================

# --- Telegram Alerting & SRE Bot Configuration ---
# Token from @BotFather for SRE incident notifier bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID of the duty engineer (can be paired via PIN code in Web UI)
TELEGRAM_CHAT_ID=

# Toggle Telegram push alerts (true/false)
TELEGRAM_ALERTS_ENABLED=false

# --- LLM Engine Configuration ---
# Provider options: "groq", "ollama", "openai", "fallback"
LLM_PROVIDER=groq

# Model identifier
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# API Keys (leave empty if using local Ollama or Fallback mode)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama settings (used if LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b

# --- Database & Storage ---
# Default is SQLite for local zero-dependency setup: sqlite:///./logs.db
# Or PostgreSQL for production: postgresql://postgres:postgres@localhost:5432/rca_db
DATABASE_URL=sqlite:///./logs.db

# --- Alerting & Incident Grouping Rules ---
ALERT_MIN_LEVEL=ERROR
ALERT_CASCADE_ONLY=false
ALERT_MIN_ERRORS=1
ALERT_DEBOUNCE_SECONDS=1.5
LOG_RETENTION_DAYS=7
